# ── Server (apps/server) ─────────────────────────────────────────────
PORT=8787
# Contact address for upstream APIs (MET Norway ToS). Placeholder domains (example.com) get HTTP 403.
CONTACT_EMAIL=
# Restrict CORS if the web app is hosted on a different origin (default "*")
CORS_ORIGIN=*
# Where config (spots.json, cameras.json) and data (push subscriptions, sightings, VAPID keys) live
# CONFIG_DIR=./config
# DATA_DIR=./data
# Web-push keys. If unset, a key pair is generated once and saved to DATA_DIR/vapid.json.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.is
# Alert poller interval (ms), default 5 minutes
# ALERT_INTERVAL_MS=300000
# Path to the built PWA (default apps/web/dist)
# WEB_DIST=

# ── Web (apps/web) — only if the API lives on another origin ─────────
# VITE_API_BASE=https://api.example.org
