# Server (apps/server)
PORT=8787
# Real contact address — required by MET Norway's terms. Placeholder domains (example.com) get HTTP 403.
CONTACT_EMAIL=
# Restrict CORS if the web app is hosted on a different origin (default "*", data is public/read-only)
CORS_ORIGIN=*
# Override where the built PWA is served from (default ../web/dist)
# WEB_DIST=

# Web (apps/web) — only if the API lives on another origin
# VITE_API_BASE=https://api.example.org
